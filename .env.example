# PoemVideo Studio 环境配置示例:复制为 .env 后按实际环境修改

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# ComfyUI 地址:容器内访问宿主机 ComfyUI 用 host.docker.internal
# (docker-compose 已配置 extra_hosts: host-gateway;Linux 也可直接填内网 IP)
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_WS_URL=ws://host.docker.internal:8188/ws
COMFYUI_CLIENT_ID=poem-video-studio

# 数据根目录:Docker 内固定为卷挂载路径 /data/poem-video-studio
# 本地开发默认使用仓库内 data/poem-video-studio,可不用配置
DATA_ROOT=/data/poem-video-studio

# Workflow 模板与节点映射(容器内路径,由 compose 挂载 ./workflows 到 /app/workflows)
WORKFLOW_TEMPLATE=/app/workflows/minimax_h3_poem_v1.json
WORKFLOW_MAP=/app/workflows/workflow-map.yaml

# 默认生成参数(可按实测 Workflow 调整,不在代码中硬编码)
DEFAULT_WIDTH=768
DEFAULT_HEIGHT=1024
DEFAULT_FPS=24
DEFAULT_NUM_FRAMES=121

# 上传限制
UPLOAD_MAX_SIZE_MB=20

# 服务器控制中心(任务04/05):Web API 经宿主机 Agent 执行 GPU/服务操作
# Agent 部署见 agent/README.md;容器内经 host.docker.internal(host-gateway)访问
AGENT_BASE_URL=http://host.docker.internal:8300
# 可选:与 Agent 侧 AGENT_TOKEN 一致,为空则不校验
AGENT_TOKEN=
# 一键环境 Profile(容器内路径,compose 已挂载 ./server 到 /app/server)
SERVER_PROFILES_FILE=/app/server/profiles.yaml

# Docker 端口映射
API_PORT=8000
WEB_PORT=8080
